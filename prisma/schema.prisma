model Proposal {
  proposal_id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposal_code                String?        @unique @default(dbgenerated("('PRC-'::text || nextval('proposal_code_sequence'::regclass)::text)")) @db.VarChar(40)
  deal_id                      String         @db.Uuid
  client_id                    String         @db.Uuid
  survey_id                    String?        @db.Uuid
  created_by                   String         @db.Uuid
  title                        String         @db.VarChar(180)
  status                       String         @default("draft") @db.VarChar(50)
  access_token                 String         @unique @db.VarChar(120)
  currency                     String         @default("USD") @db.VarChar(3)
  subtotal_amount              Decimal        @default(0) @db.Decimal(12, 2)
  selected_total_amount        Decimal        @default(0) @db.Decimal(12, 2)

  // Налог с продаж. В Калифорнии обязателен и зависит от адреса объекта,
  // поэтому ставка сохраняется в самом КП: пересчёт задним числом
  // изменил бы сумму уже отправленного клиенту документа.
  tax_rate_percent             Decimal        @default(0) @db.Decimal(5, 2)
  tax_amount                   Decimal        @default(0) @db.Decimal(12, 2)
  total_with_tax               Decimal        @default(0) @db.Decimal(12, 2)

  // Сегмент объекта. От него зависит и гарантия, и предельный размер аванса:
  // для жилья в Калифорнии аванс ограничен законом.
  property_type                String         @default("residential") @db.VarChar(20)

  // Выбранный клиентом уровень пакета: essential | signature | prime
  selected_tier                String?        @db.VarChar(30)
  client_message               String?        @db.Text
  notes                        String?        @db.Text
  sent_at                      DateTime?      @db.Timestamptz(6)
  client_viewed_at             DateTime?      @db.Timestamptz(6)
  client_updated_at            DateTime?      @db.Timestamptz(6)
  expires_at                   DateTime?      @db.Timestamptz(6)
  created_at                   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime       @updatedAt @db.Timestamptz(6)
  deal                         Deal           @relation(fields: [deal_id], references: [deal_id], onDelete: Cascade)
  client                       Client         @relation(fields: [client_id], references: [client_id], onDelete: Restrict)
  survey                       Survey?        @relation(fields: [survey_id], references: [survey_id], onDelete: SetNull)
  created_by_user              User           @relation("proposal_created_by", fields: [created_by], references: [user_id], onDelete: Restrict)
  proposal_items               ProposalItem[]
  proposal_events              ProposalEvent[]
  agreement                    Agreement?
  deposit                      Deposit?
  project                      Project?

  @@index([deal_id])
  @@index([client_id])
  @@index([survey_id])
  @@index([created_by])
  @@index([status])
  @@map("proposals")
}


  actor_user_id                String?     @db.Uuid
  entity_type                  String?     @db.VarChar(60)
  entity_id                    String?     @db.Uuid
  type_key                     String      @db.VarChar(80)
  title                        String      @db.VarChar(180)
  message                      String      @db.Text
  is_read                      Boolean     @default(false)
  read_at                      DateTime?   @db.Timestamptz(6)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  recipient_user               User        @relation("notification_recipient", fields: [recipient_user_id], references: [user_id], onDelete: Cascade)
  actor_user                   User?       @relation("notification_actor", fields: [actor_user_id], references: [user_id], onDelete: SetNull)

  @@index([recipient_user_id])
  @@index([actor_user_id])
  @@map("notifications")
}

model EmailAction {
  email_action_id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type                  String      @db.VarChar(60)
  entity_id                    String?     @db.Uuid
  recipient_email              String      @db.VarChar(191)
  subject                      String      @db.VarChar(255)
  status                       String      @default("pending") @db.VarChar(50)
  created_by                   String      @db.Uuid
  sent_at                      DateTime?   @db.Timestamptz(6)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  created_by_user              User        @relation("email_action_created_by", fields: [created_by], references: [user_id], onDelete: Restrict)

  @@index([created_by])
  @@map("email_actions")
}

model GmailConnection {
  gmail_connection_id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  connection_key          String         @unique @default("primary") @db.VarChar(80)
  email_address           String         @db.VarChar(191)
  access_token_encrypted  String         @db.Text
  refresh_token_encrypted String         @db.Text
  token_expires_at        DateTime?      @db.Timestamptz(6)
  scope                   String?        @db.Text
  history_id              String?        @db.VarChar(80)
  last_synced_at          DateTime?      @db.Timestamptz(6)
  sync_error              String?        @db.Text
  is_active               Boolean        @default(true)
  connected_by            String         @db.Uuid
  created_at              DateTime       @default(now()) @db.Timestamptz(6)
  updated_at              DateTime       @updatedAt @db.Timestamptz(6)
  connected_by_user       User           @relation("gmail_connection_connected_by", fields: [connected_by], references: [user_id], onDelete: Restrict)
  messages                GmailMessage[]

  @@index([connected_by])
  @@map("gmail_connections")
}

model GmailMessage {
  gmail_message_id        String          @id @db.VarChar(120)
  gmail_thread_id         String          @db.VarChar(120)
  gmail_connection_id     String          @db.Uuid
  direction               String          @db.VarChar(20)
  sender_email            String?         @db.VarChar(191)
  sender_name             String?         @db.VarChar(191)
  recipient_emails        String[]        @default([])
  cc_emails               String[]        @default([])
  subject                 String          @default("") @db.VarChar(500)
  snippet                 String          @default("") @db.Text
  body_text               String          @default("") @db.Text
  label_ids               String[]        @default([])
  is_unread               Boolean         @default(false)
  sent_at                 DateTime         @db.Timestamptz(6)
  legacy_client_id        String?          @db.VarChar(120)
  legacy_order_id         String?          @db.VarChar(120)
  raw_headers             Json?
  attachment_meta         Json?
  created_at              DateTime         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime         @updatedAt @db.Timestamptz(6)
  connection              GmailConnection @relation(fields: [gmail_connection_id], references: [gmail_connection_id], onDelete: Cascade)

  @@index([gmail_connection_id, sent_at])
  @@index([gmail_thread_id])
  @@index([legacy_client_id])
  @@index([legacy_order_id])
  @@index([is_unread])
  @@map("gmail_messages")
}

model FollowUp {

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String           @unique @db.VarChar(191)
  full_name               String           @db.VarChar(160)
  password_hash           String?          @db.Text
  must_change_password    Boolean          @default(true)
  legacy_user_ids         String[]         @default([])
  is_active               Boolean          @default(true)
  last_login_at           DateTime?        @db.Timestamptz(6)
  created_at              DateTime         @default(now()) @db.Timestamptz(6)
  updated_at              DateTime         @updatedAt @db.Timestamptz(6)
  user_accesses           UserAccess[]
  leads_assigned          Lead[]           @relation("lead_manager")
  deals_assigned          Deal[]           @relation("deal_manager")
  managed_projects        Project[]        @relation("project_manager")
  led_projects            Project[]        @relation("project_lead_installer")
  assigned_calendar_events CalendarEvent[] @relation("calendar_event_assignee")
  installer_jobs          InstallerJob[]   @relation("installer_job_user")
  uploaded_files          AttachmentFile[] @relation("attachment_uploaded_by")
  created_documents       Document[]       @relation("document_created_by")
  activity_logs           ActivityLog[]    @relation("activity_actor")
  received_notifications  Notification[]   @relation("notification_recipient")
  actor_notifications     Notification[]   @relation("notification_actor")
  created_email_actions   EmailAction[]    @relation("email_action_created_by")
  created_follow_ups      FollowUp[]       @relation("follow_up_created_by")
  assigned_follow_ups     FollowUp[]       @relation("follow_up_assigned_to")
  created_tasks           Task[]           @relation("task_created_by")
  assigned_tasks          Task[]           @relation("task_assigned_to")
  assigned_consultations  Consultation[]   @relation("consultation_assigned_consultant")
  managed_consultations   Consultation[]   @relation("consultation_assigned_manager")
  created_consultations   Consultation[]   @relation("consultation_created_by")
  created_proposals       Proposal[]       @relation("proposal_created_by")
  proposal_events         ProposalEvent[]  @relation("proposal_event_actor")
  updated_legacy_workspaces LegacyWorkspace[] @relation("legacy_workspace_updated_by")
  gmail_connections       GmailConnection[] @relation("gmail_connection_connected_by")
  twilio_messages         TwilioMessage[]  @relation("twilio_message_actor")

  @@map("users")
}

model Role {
  role_id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String       @unique @db.VarChar(50)
  name_ru          String       @db.VarChar(120)
  name_en          String       @db.VarChar(120)
  description_ru   String?      @db.Text
  description_en   String?      @db.Text
  is_system        Boolean      @default(true)
  is_active        Boolean      @default(true)
  sort_order       Int          @default(0)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @updatedAt @db.Timestamptz(6)
  user_accesses    UserAccess[]

  @@map("roles")
}

model UserAccess {
  user_access_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  role_id          String    @db.Uuid
  is_primary       Boolean   @default(false)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  user             User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role             Role      @relation(fields: [role_id], references: [role_id], onDelete: Restrict)

  @@unique([user_id, role_id])
  @@index([role_id])
  @@map("user_access")
}

model ServiceType {
  service_type_id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_code                 String               @unique @db.VarChar(50)
  name_ru                      String               @db.VarChar(120)
  name_en                      String               @db.VarChar(120)
  unit_type                    String               @db.VarChar(50)
  base_price                   Decimal              @default(0) @db.Decimal(12, 2)
  min_price                    Decimal              @default(0) @db.Decimal(12, 2)
  material_cost_per_sqft       Decimal              @default(0) @db.Decimal(12, 2)
  installation_cost_per_sqft   Decimal              @default(0) @db.Decimal(12, 2)
  block_revenue_price          Decimal              @default(0) @db.Decimal(12, 2)
  block_cost_price             Decimal              @default(0) @db.Decimal(12, 2)
  is_active                    Boolean              @default(true)
  sort_order                   Int                  @default(0)
  created_at                   DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime             @updatedAt @db.Timestamptz(6)
  service_field_configs        ServiceFieldConfig[]
  service_addons               ServiceAddon[]
  project_positions            ProjectPosition[]
  survey_recommendations       SurveyRecommendation[]
  proposal_items               ProposalItem[]

  @@map("service_types")
}

model ServiceFieldConfig {
  service_field_config_id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_type_id              String      @db.Uuid
  field_key                    String      @db.VarChar(80)
  field_label_ru               String      @db.VarChar(160)
  field_label_en               String      @db.VarChar(160)
  input_type                   String      @db.VarChar(50)
  data_type                    String      @db.VarChar(50)
  dropdown_source              String?     @db.VarChar(80)
  is_required                  Boolean     @default(false)
  default_value                Json?
  sort_order                   Int         @default(0)
  is_active                    Boolean     @default(true)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  service_type                 ServiceType @relation(fields: [service_type_id], references: [service_type_id], onDelete: Cascade)

  @@unique([service_type_id, field_key])
  @@map("service_field_config")
}

model ServiceAddon {
  service_addon_id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_type_id              String      @db.Uuid
  addon_code                   String      @db.VarChar(50)
  name_ru                      String      @db.VarChar(120)
  name_en                      String      @db.VarChar(120)
  unit_type                    String      @db.VarChar(50)
  default_price                Decimal     @default(0) @db.Decimal(12, 2)
  min_price                    Decimal     @default(0) @db.Decimal(12, 2)
  cost_price                   Decimal     @default(0) @db.Decimal(12, 2)
  is_active                    Boolean     @default(true)
  sort_order                   Int         @default(0)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  service_type                 ServiceType @relation(fields: [service_type_id], references: [service_type_id], onDelete: Cascade)
  position_addons              ProjectPositionAddon[]

  @@unique([service_type_id, addon_code])
  @@map("service_addons")
}

model FilmCatalog {
  film_id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_code                String            @db.VarChar(50)
  category_name_ru             String            @db.VarChar(120)
  category_name_en             String            @db.VarChar(120)
  brand_code                   String            @db.VarChar(50)
  brand_name_ru                String            @db.VarChar(120)
  brand_name_en                String            @db.VarChar(120)
  model_code                   String            @unique @db.VarChar(80)
  model_name_ru                String            @db.VarChar(120)
  model_name_en                String            @db.VarChar(120)
  thickness                    String?           @db.VarChar(50)
  unit                         String            @db.VarChar(30)

  // Оптические параметры для подбора плёнки на замере.
  // Заполняются из спецификации производителя. Пустое значение
  // означает "нет данных" и исключает модель из автоподбора.
  vlt_percent                  Decimal?          @db.Decimal(5, 2)
  uv_rejection_percent         Decimal?          @db.Decimal(5, 2)
  ir_rejection_percent         Decimal?          @db.Decimal(5, 2)
  tser_percent                 Decimal?          @db.Decimal(5, 2)

  // Коды типов остекления, на которые модель разрешена:
  // ["single_tempered","single_annealed","dual_pane","low_e","skylight","panoramic"]
  allowed_glass_types          Json?
  // Стороны света, где модель не рекомендуется: ["south","west"]
  restricted_orientations      Json?
  // true — замерщик не выбирает сам, решение принимает специалист
  requires_review              Boolean           @default(false)
  selection_note_ru            String?           @db.Text

  is_active                    Boolean           @default(true)
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  project_positions            ProjectPosition[]
  survey_recommendations       SurveyRecommendation[]
  proposal_items               ProposalItem[]

  @@map("film_catalog")
}

model ProjectStatus {
  project_status_id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status_code                  String      @unique @db.VarChar(50)
  name_ru                      String      @db.VarChar(120)
  name_en                      String      @db.VarChar(120)
  color_token                  String?     @db.VarChar(50)
  is_closed                    Boolean     @default(false)
  is_active                    Boolean     @default(true)
  sort_order                   Int         @default(0)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  projects                     Project[]

  @@map("project_statuses")
}

model PaymentStatus {
  payment_status_id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status_code                  String      @unique @db.VarChar(50)
  name_ru                      String      @db.VarChar(120)
  name_en                      String      @db.VarChar(120)
  color_token                  String?     @db.VarChar(50)
  is_closed                    Boolean     @default(false)
  is_active                    Boolean     @default(true)
  sort_order                   Int         @default(0)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  projects                     Project[]

  @@map("payment_statuses")
}

model PositionStatus {
  position_status_id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status_code                  String            @unique @db.VarChar(50)
  name_ru                      String            @db.VarChar(120)
  name_en                      String            @db.VarChar(120)
  color_token                  String?           @db.VarChar(50)
  is_closed                    Boolean           @default(false)
  is_active                    Boolean           @default(true)
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  project_positions            ProjectPosition[]

  @@map("position_statuses")
}

model EventType {
  event_type_id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_code                   String            @unique @db.VarChar(50)
  name_ru                      String            @db.VarChar(120)
  name_en                      String            @db.VarChar(120)
  color_token                  String?           @db.VarChar(50)
  is_active                    Boolean           @default(true)
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  calendar_events              CalendarEvent[]

  @@map("event_types")
}

model EventTrack {
  event_track_id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  track_code                   String            @unique @db.VarChar(50)
  name_ru                      String            @db.VarChar(120)
  name_en                      String            @db.VarChar(120)
  color_token                  String?           @db.VarChar(50)
  is_active                    Boolean           @default(true)
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  calendar_events              CalendarEvent[]

  @@map("event_tracks")
}

model ComplexityLevel {
  complexity_level_id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level_code                   String            @unique @db.VarChar(50)
  name_ru                      String            @db.VarChar(120)
  name_en                      String            @db.VarChar(120)
  numeric_rank                 Int               @default(1)
  multiplier                   Decimal           @default(1) @db.Decimal(6, 2)
  color_token                  String?           @db.VarChar(50)
  is_active                    Boolean           @default(true)
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  project_positions            ProjectPosition[]
  measurements                 Measurement[]

  @@map("complexity_levels")
}

model City {
  city_id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  city_code                    String      @unique @db.VarChar(50)
  name_ru                      String      @db.VarChar(120)
  name_en                      String      @db.VarChar(120)
  state_code                   String?     @db.VarChar(20)
  default_zip_code             String?     @db.VarChar(20)
  is_active                    Boolean     @default(true)
  sort_order                   Int         @default(0)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  leads                        Lead[]
  clients                      Client[]
  projects                     Project[]

  @@map("cities")
}

model DocumentType {
  document_type_id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  document_code                String      @unique @db.VarChar(50)
  name_ru                      String      @db.VarChar(120)
  name_en                      String      @db.VarChar(120)
  requires_signature           Boolean     @default(false)
  is_active                    Boolean     @default(true)
  sort_order                   Int         @default(0)
  created_at                   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime    @updatedAt @db.Timestamptz(6)
  documents                    Document[]

  @@map("document_types")
}

model PipelineStatus {
  pipeline_status_id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status_code                   String      @unique @db.VarChar(60)
  name_ru                       String      @db.VarChar(140)
  name_en                       String      @db.VarChar(140)
  stage_group                   String      @db.VarChar(40)
  color_token                   String?     @db.VarChar(50)
  is_closed                     Boolean     @default(false)
  sort_order                    Int         @default(0)
  is_active                     Boolean     @default(true)
  created_at                    DateTime    @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime    @updatedAt @db.Timestamptz(6)
  leads                         Lead[]
  deals                         Deal[]

  @@map("pipeline_statuses")
}

model Lead {
  lead_id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_code                    String?           @unique @db.VarChar(40)
  name                         String            @db.VarChar(160)
  phone                        String?           @db.VarChar(40)
  email                        String?           @db.VarChar(191)
  source                       String?           @db.VarChar(120)
  pipeline_status_id           String            @db.Uuid
  city_id                      String?           @db.Uuid
  assigned_manager_id          String?           @db.Uuid
  notes                        String?           @db.Text
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  city                         City?             @relation(fields: [city_id], references: [city_id], onDelete: SetNull)
  pipeline_status              PipelineStatus    @relation(fields: [pipeline_status_id], references: [pipeline_status_id], onDelete: Restrict)
  assigned_manager             User?             @relation("lead_manager", fields: [assigned_manager_id], references: [user_id], onDelete: SetNull)
  deals                        Deal[]
  calendar_events              CalendarEvent[]
  attachments_files            AttachmentFile[]
  follow_ups                   FollowUp[]
  tasks                        Task[]
  consultations                Consultation[]

  @@index([assigned_manager_id])
  @@index([city_id])
  @@index([pipeline_status_id])
  @@map("leads")
}

model Client {
  client_id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_code                  String?           @unique @db.VarChar(40)
  name                         String            @db.VarChar(160)
  phone                        String?           @db.VarChar(40)
  email                        String?           @db.VarChar(191)
  billing_address              String?           @db.Text
  service_address              String?           @db.Text
  city_id                      String?           @db.Uuid
  zip_code                     String?           @db.VarChar(20)
  notes                        String?           @db.Text
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  city                         City?             @relation(fields: [city_id], references: [city_id], onDelete: SetNull)
  deals                        Deal[]
  projects                     Project[]
  documents                    Document[]
  consultations                Consultation[]
  proposals                    Proposal[]

  @@index([city_id])
  @@map("clients")
}

model Deal {
  deal_id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deal_code                    String?           @unique @db.VarChar(40)
  lead_id                      String?           @db.Uuid
  client_id                    String?           @db.Uuid
  assigned_manager_id          String?           @db.Uuid
  pipeline_status_id           String            @db.Uuid
  title                        String            @db.VarChar(160)
  estimated_value              Decimal           @default(0) @db.Decimal(12, 2)
  currency                     String            @default("USD") @db.VarChar(3)
  notes                        String?           @db.Text
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  lead                         Lead?             @relation(fields: [lead_id], references: [lead_id], onDelete: SetNull)
  client                       Client?           @relation(fields: [client_id], references: [client_id], onDelete: SetNull)
  assigned_manager             User?             @relation("deal_manager", fields: [assigned_manager_id], references: [user_id], onDelete: SetNull)
  pipeline_status              PipelineStatus    @relation(fields: [pipeline_status_id], references: [pipeline_status_id], onDelete: Restrict)
  projects                     Project[]
  calendar_events              CalendarEvent[]
  attachments_files            AttachmentFile[]
  documents                    Document[]
  follow_ups                   FollowUp[]
  tasks                        Task[]
  consultations                Consultation[]
  proposals                    Proposal[]

  @@index([lead_id])
  @@index([client_id])
  @@index([assigned_manager_id])
  @@index([pipeline_status_id])
  @@map("deals")
}

model Project {
  project_id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_code                 String?           @unique @db.VarChar(40)
  client_id                    String            @db.Uuid
  deal_id                      String?           @db.Uuid
  proposal_id                  String?           @unique @db.Uuid
  manager_id                   String?           @db.Uuid
  lead_installer_id            String?           @db.Uuid
  project_status_id            String            @db.Uuid
  payment_status_id            String?           @db.Uuid
  city_id                      String?           @db.Uuid
  title                        String            @db.VarChar(160)
  address                      String?           @db.Text
  zip_code                     String?           @db.VarChar(20)
  install_date                 DateTime?         @db.Date
  start_time                   DateTime?         @db.Time(6)
  end_time                     DateTime?         @db.Time(6)
  priority                     String            @default("normal") @db.VarChar(30)
  problem_flag                 Boolean           @default(false)
  manager_notes                String?           @db.Text
  installer_notes              String?           @db.Text
  what_to_bring                String?           @db.Text
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  client                       Client            @relation(fields: [client_id], references: [client_id], onDelete: Restrict)
  deal                         Deal?             @relation(fields: [deal_id], references: [deal_id], onDelete: SetNull)
  proposal                     Proposal?         @relation(fields: [proposal_id], references: [proposal_id], onDelete: SetNull)
  manager                      User?             @relation("project_manager", fields: [manager_id], references: [user_id], onDelete: SetNull)
  lead_installer               User?             @relation("project_lead_installer", fields: [lead_installer_id], references: [user_id], onDelete: SetNull)
  project_status               ProjectStatus     @relation(fields: [project_status_id], references: [project_status_id], onDelete: Restrict)
  payment_status               PaymentStatus?    @relation(fields: [payment_status_id], references: [payment_status_id], onDelete: SetNull)
  city                         City?             @relation(fields: [city_id], references: [city_id], onDelete: SetNull)
  project_positions            ProjectPosition[]
  schedule_assignment          ScheduleAssignment?
  calendar_events              CalendarEvent[]
  installer_jobs               InstallerJob[]
  attachments_files            AttachmentFile[]
  documents                    Document[]
  activity_logs                ActivityLog[]
  consultations                Consultation[]

  @@index([client_id])
  @@index([deal_id])
  @@index([proposal_id])
  @@index([manager_id])
  @@index([lead_installer_id])
  @@index([project_status_id])
  @@index([payment_status_id])
  @@index([city_id])
  @@map("projects")
}

model ProjectPosition {
  position_id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                   String            @db.Uuid
  proposal_item_id             String?           @unique @db.Uuid
  service_type_id              String            @db.Uuid
  film_id                      String?           @db.Uuid
  position_status_id           String            @db.Uuid
  complexity_level_id          String?           @db.Uuid
  title                        String?           @db.VarChar(160)
  dynamic_fields               Json?
  pricing_source               String            @default("manual") @db.VarChar(50)
  base_price                   Decimal           @default(0) @db.Decimal(12, 2)
  min_price                    Decimal           @default(0) @db.Decimal(12, 2)
  actual_price                 Decimal           @default(0) @db.Decimal(12, 2)
  notes                        String?           @db.Text
  sort_order                   Int               @default(0)
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime          @updatedAt @db.Timestamptz(6)
  project                      Project           @relation(fields: [project_id], references: [project_id], onDelete: Cascade)
  proposal_item                ProposalItem?     @relation(fields: [proposal_item_id], references: [proposal_item_id], onDelete: SetNull)
  service_type                 ServiceType       @relation(fields: [service_type_id], references: [service_type_id], onDelete: Restrict)
  film                         FilmCatalog?      @relation(fields: [film_id], references: [film_id], onDelete: SetNull)
  position_status              PositionStatus    @relation(fields: [position_status_id], references: [position_status_id], onDelete: Restrict)
  complexity_level             ComplexityLevel?  @relation(fields: [complexity_level_id], references: [complexity_level_id], onDelete: SetNull)
  installer_job                InstallerJob?
  attachments_files            AttachmentFile[]
  position_addons              ProjectPositionAddon[]

  @@index([project_id])
  @@index([proposal_item_id])
  @@index([service_type_id])
  @@index([film_id])
  @@index([position_status_id])
  @@index([complexity_level_id])
  @@map("project_positions")
}

model ProjectPositionAddon {
  position_addon_id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position_id                  String        @db.Uuid
  service_addon_id             String        @db.Uuid
  quantity                     Decimal       @default(1) @db.Decimal(10, 2)
  unit_price                   Decimal       @default(0) @db.Decimal(12, 2)
  total_price                  Decimal       @default(0) @db.Decimal(12, 2)
  notes                        String?       @db.Text
  created_at                   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime      @updatedAt @db.Timestamptz(6)
  position                     ProjectPosition @relation(fields: [position_id], references: [position_id], onDelete: Cascade)
  service_addon                ServiceAddon  @relation(fields: [service_addon_id], references: [service_addon_id], onDelete: Restrict)

  @@unique([position_id, service_addon_id])

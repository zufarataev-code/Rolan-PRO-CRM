{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rolanpro-wholesale",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "triggers": {
    // 08:30 Pacific on weekdays (16:30 UTC during PST; 15:30 PDT). Sends the day's batch.
    "crons": ["30 16 * * 1-5"]
  },
  "vars": {
    "PUBLIC_URL": "https://wholesale.rolanpro-supply.com",
    "FROM_EMAIL": "Zak at RolanPRO <zak@rolanpro-supply.com>",
    "REPLY_TO": "zak@rolanpro-supply.com",
    "OWNER_EMAIL": "info@rolan-pro.com",
    "COMPANY_PHONE": "+1 (424) 325-0512",
    "DAILY_LIMIT": "40",
    "WARMUP_DAYS": "7",
    "WARMUP_START_LIMIT": "15",
    "ANTHROPIC_MODEL": "claude-sonnet-4-5",
    "ZELLE_TO": "info@rolan-pro.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rolanpro_wholesale",
      // Fill after `wrangler d1 create rolanpro_wholesale`
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ]
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY, ANTHROPIC_API_KEY, ADMIN_TOKEN, STRIPE_SECRET_KEY (optional)
  // Inbound mail: Cloudflare Email Routing → route zak@rolanpro-supply.com to this Worker (email handler in src/index.ts)
}

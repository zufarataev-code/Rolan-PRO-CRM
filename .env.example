DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rolanpro"
# Required in production: unique random value with at least 32 characters.
AUTH_SECRET="change-me-before-production"
# Development only. Demo login is always disabled when NODE_ENV=production.
ENABLE_DEMO_LOGIN="false"
# Optional owner recovery. Set to force the owner password on next boot, then remove it.
ROLANPRO_OWNER_PASSWORD=""
SESSION_COOKIE_NAME="rolanpro_session"
SESSION_TTL_HOURS="168"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"
GMAIL_CLIENT_ID="replace-me.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="replace-me"
GMAIL_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
GMAIL_ALLOWED_ADDRESS="info@rolan-pro.com"
# Separate sender for congratulations, review requests, newsletters, and campaigns.
# Keep false until marketing templates and deliverability are explicitly approved.
MARKETING_EMAIL_ENABLED="false"
MARKETING_EMAIL_PROVIDER="resend"
MARKETING_EMAIL_API_KEY="re_replace_me"
MARKETING_EMAIL_FROM="RolanPRO <hello@updates.rolan-pro.com>"
MARKETING_EMAIL_REPLY_TO="info@rolan-pro.com"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-me-for-webhook-validation"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="replace-me"
TWILIO_FROM_NUMBER="+18335551212"
# Approved Twilio WhatsApp sender in E.164 format (Sandbox or production sender).
TWILIO_WHATSAPP_FROM=""
# Optional alternative to TWILIO_FROM_NUMBER:
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_WEBHOOK_BASE_URL="https://crm.example.com"
# Zadarma PBX: generated in Settings → Integrations and API.
# These secrets stay on the CRM server and are never sent to the browser.
ZADARMA_API_KEY=""
ZADARMA_API_SECRET=""
ZADARMA_WEBHOOK_BASE_URL="https://crm.example.com"

# Server-to-server website lead ingestion. Keep secret only on CRM and website servers.
WEBSITE_LEAD_INGEST_SECRET=""

# Google Ads / Data Manager integration.
# Safe-by-default: no live uploads until account setup and controlled validation pass.
# As of 2026-09-09 Google Ads API access levels are managed by the Google Cloud
# project that owns the OAuth client/service account. A developer token is no longer required.
GOOGLE_CLOUD_PROJECT_ID=""
GOOGLE_ADS_CONVERSION_OWNER_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_QUALIFIED_LEAD_ACTION_ID=""
GOOGLE_ADS_CONVERTED_LEAD_ACTION_ID=""
GOOGLE_ADS_UPLOAD_ENABLED="false"
GOOGLE_ADS_VALIDATE_ONLY="true"
# Use either the OAuth refresh-token flow OR a service account with Ads account access.
# All values stay server-side and must never use NEXT_PUBLIC_* names.
GOOGLE_ADS_OAUTH_CLIENT_ID=""
GOOGLE_ADS_OAUTH_CLIENT_SECRET=""
GOOGLE_ADS_OAUTH_REFRESH_TOKEN=""
GOOGLE_ADS_SERVICE_ACCOUNT_EMAIL=""
# Store a PEM key in the secret manager; escaped \n is supported by the server loader.
GOOGLE_ADS_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional legacy compatibility only. Google Ads API servers ignore this for access decisions.
GOOGLE_ADS_DEVELOPER_TOKEN=""

# Client payment package. Real values belong only in protected server env.
ROLANPRO_ZELLE_RECIPIENT=""
ROLANPRO_BANK_TRANSFER_INSTRUCTIONS=""
# Optional secure online checkout. When configured, CRM creates a fresh Stripe
# Checkout Session for the deposit amount + the server-enforced 3.5% fee.
# Never expose this key through NEXT_PUBLIC_* variables or commit a real key.
STRIPE_SECRET_KEY=""
